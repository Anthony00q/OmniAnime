{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "allowJs": true,
    "checkJs": false,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["checks/**/*.ts", "scripts/test-groups.mjs", "src/renderer/globals.d.ts"],
  "exclude": ["node_modules", "dist", "release"]
}
